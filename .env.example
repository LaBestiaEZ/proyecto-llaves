# Variables de Entorno - Ejemplo
# Copiar este archivo como .env y rellenar con los valores reales
# ⚠️ NUNCA SUBIR EL ARCHIVO .env REAL A GIT

###> PostgreSQL Database ###
POSTGRES_DB=nombre_base_datos
POSTGRES_USER=usuario_db
POSTGRES_PASSWORD=password_seguro_aqui
DB_PORT=5432
###< PostgreSQL Database ###

###> Symfony Framework ###
APP_ENV=prod
APP_SECRET=generar_secreto_de_32_caracteres_aleatorios
APP_DEBUG=0
###< Symfony Framework ###

###> JWT Authentication ###
# Passphrase para las claves JWT (usa una contraseña segura)
# Genera uno con: openssl rand -base64 32
JWT_PASSPHRASE=generar_passphrase_seguro
JWT_TTL=3600
###< JWT Authentication ###

###> CORS Configuration ###
# Permitir peticiones desde ngrok y localhost
# Ajustar según tu dominio de ngrok
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1|.*\.ngrok-free\.app)(:[0-9]+)?$
###< CORS Configuration ###

###> Puertos de los Servicios ###
WEBSERVER_PORT=80
PORTAINER_PORT=9000
PORTAINER_HTTPS_PORT=9443
NGROK_PORT=4040
###< Puertos de los Servicios ###

###> ngrok Configuration ###
# Token de autenticación de ngrok (obtener en https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=tu_token_de_ngrok_aqui
# Dominio personalizado de ngrok (opcional, requiere cuenta de pago)
# Si no tienes dominio, ngrok generará uno aleatorio - dejar vacío
NGROK_DOMAIN=
###< ngrok Configuration ###
